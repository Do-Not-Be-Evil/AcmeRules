{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Rules": {
    "Path": "Config/rules.json"
  },
  "RateLimit": {
    "PermitLimit": 30,
    "WindowSeconds": 60
  },
  "Auth": {
    "UseDevAuth": false
  }
}
